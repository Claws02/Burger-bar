{
  "appId": "com.clawengineering.burgerbar",
  "appName": "Burger Bar",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0e16",
    "scrollEnabled": false,
    "allowsLinkPreview": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "launchShowDuration": 0,
      "backgroundColor": "#0a0e16",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
